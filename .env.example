# =============================================================================
# Pruszkow News Pipeline - Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# After editing, restart the server for changes to take effect.
# =============================================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Gmail ---
# Path to Google OAuth2 credentials JSON (relative to project root)
# Download from: https://console.cloud.google.com/apis/credentials
GMAIL_CREDENTIALS_FILE=client_secret.json

# --- AI Provider ---
# Options: gemini, claude, openai
AI_PROVIDER=gemini

# --- API Keys ---
# Get your key from the provider's console:
#   Gemini:  https://aistudio.google.com/apikey
#   Claude:  https://console.anthropic.com/
#   OpenAI:  https://platform.openai.com/api-keys
#
# Only the key for your chosen AI_PROVIDER is required.
# Others are optional if you want to switch later.

GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=

# --- Model Names (optional - defaults shown) ---
# Only change if you want a different model from the same provider.
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o

# =============================================================================
# The following settings are stored in data/ JSON files and managed via the
# Settings page in the UI. They are listed here for reference only.
# Do NOT put them in .env — use the UI or edit the JSON files directly.
# =============================================================================
#
# data/article_settings.json:
#   min_words: 500          # Minimum article word count
#   max_words: 200          # Maximum article word count
#   language: "polish"      # Options: "polish", "english", "auto"
#   default_mode: "batch"   # Options: "batch", "single"
#
# data/system_rules.json:
#   rules: "..."            # System prompt for AI (edit via Settings UI)
#
# data/ignored_senders.json:
#   [...]                   # List of sender substrings to block
#
# data/quota.json:
#   daily_requests: 0       # 0 = unlimited
#   weekly_requests: 0
#   monthly_requests: 0
#   daily_tokens: 0
#   weekly_tokens: 0
#   monthly_tokens: 0
# =============================================================================
